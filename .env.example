# Copy this file to ".env" and fill in the value below. The ".env" file is
# ignored by git and must never be committed.
#
# Free API key: create an account on https://openrouter.ai (GitHub or Google
# sign-in), open the "Keys" page, create a key and paste it here.
OPENROUTER_API_KEY=

# Optional settings of Docker Compose.
#
# Absolute path of a Hugging Face cache that already holds the models (for example the one used by
# the notebooks), to avoid downloading about 2.3 GB again inside Docker:
# MODEL_CACHE=/Users/me/.cache/huggingface
#
# Ports on this machine for the web interface and for the dashboard of the vector database:
# FRONTEND_PORT=8080
# QDRANT_PORT=6333
